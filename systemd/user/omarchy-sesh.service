[Unit]
Description=Omarchy session restore
# Restore needs the compositor socket; save on teardown covers clean logouts
# and power-cuts (graphical-session.target stop runs ExecStop).
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=oneshot
ExecStart=%h/.local/bin/omarchy-sesh restore
ExecStop=%h/.local/bin/omarchy-sesh save --label logout
RemainAfterExit=yes

[Install]
WantedBy=graphical-session.target
[Unit]
Description=Omarchy session periodic save
# Runs the autosave daemon for the whole graphical session so window moves are
# captured every few minutes even if the machine is powered off without logout.
After=omarchy-sesh.service
PartOf=graphical-session.target

[Service]
Type=simple
UMask=0077
ExecStart=%h/.local/bin/omarchy-sesh autosave
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
